{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnigmaSaurus",
  "version": "0.1.0",
  "identifier": "com.enigmasaurus.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EnigmaSaurus: M3/M4 Workbench",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
